{
	"name": "find-on",
	"version": "2.1.0",
	"private": true,
	"description": "Find discussions of the current URL on Reddit and Hacker News",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"format": "oxfmt --write .",
		"lint": "oxlint --type-aware --deny-warnings",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm build:firefox",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --type-aware --fix",
		"typecheck": "tsc --noEmit",
		"release:prepare": "pnpm zip && pnpm zip:firefox && node scripts/prepare-release.mjs",
		"release:sign": "node scripts/sign-firefox.mjs",
		"release:publish": "node scripts/publish-release.mjs"
	},
	"dependencies": {
		"solid-js": "1.9.18"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@wxt-dev/module-solid": "1.1.4",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"wxt": "0.21.5"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
